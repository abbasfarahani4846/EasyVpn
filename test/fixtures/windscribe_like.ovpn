client
dev tun
proto udp
remote vpn.example.com 123
verify-x509-name vpn-node.example.com name

nobind
auth-user-pass

resolv-retry infinite

cipher AES-256-GCM
ncp-ciphers AES-256-GCM:AES-256-CBC:AES-128-GCM
auth SHA512

verb 2
mute-replay-warnings
remote-cert-tls server
persist-key
persist-tun

key-direction 1
